# Relative paths are resolved from web/, not the shell working directory.
WIKI_ROOT=../examples/demo-wiki
WIKI_ID=default
# WIKI_NAME=我的知识库
LLM_API=anthropic-messages
# Required: Anthropic host root (no /v1); OpenAI compatible commonly ends in /v1
LLM_BASE_URL=
LLM_MODEL=
# Server only. Never use a VITE_ prefix for secrets.
LLM_API_KEY=
# Fixed backend / production port and development page port. Fail if occupied.
PORT=3002
WEB_PORT=5174
# QUERY_TIMEOUT_MS 未设置时按 QUERY_MAX_TOOL_CALLS × 15s + 30s 推算（默认预算 30 次即 480000）。
# QUERY_TIMEOUT_MS=180000
QUERY_MAX_TOOL_CALLS=30
# 摄入（预览-确认式）：要求 LLM_API=anthropic-messages。
# INGEST_ENABLED=false
# INGEST_MODEL 未设置时沿用 LLM_MODEL；摄入 Agent 可用更强模型，查询用轻量模型。
# INGEST_MODEL=
# INGEST_MAX_UPLOAD_MB=2
# INGEST_TIMEOUT_MS=1200000
# INGEST_MAX_TURNS=80
# INGEST_VALIDATE=auto
